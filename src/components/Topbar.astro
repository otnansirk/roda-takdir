---
---

<header class="topbar">
  <!-- Kiri: Logo Honeycomb Emas + Nama Aplikasi (Persis seperti "Beelucky" di new-1.png) -->
  <div class="brand">
    <div class="honeycomb-logo" aria-hidden="true">
      <svg width="32" height="30" viewBox="0 0 32 30" fill="none">
        <path d="M10 2L15 5V11L10 14L5 11V5L10 2Z" fill="#FFB838" />
        <path d="M21 5L26 8V14L21 17L16 14V8L21 5Z" fill="#F5931E" />
        <path d="M10 15L15 18V24L10 27L5 24V18L10 15Z" fill="#F5931E" />
        <path d="M20 18L24 20.5V25.5L20 28L16 25.5V20.5L20 18Z" fill="#FFCA5C" />
      </svg>
    </div>
    <span class="brand-name">Roda Takdir</span>
  </div>

  <!-- Kanan: Tombol Suara Lavender + Badge Tiket Oranye-Emas ("258" di new-1.png) -->
  <div class="topbar-right">
    <button
      type="button"
      id="soundToggleBtn"
      class="btn-lavender-pill"
      aria-pressed="true"
      title="Pengaturan Suara Putaran"
    >
      <span id="soundIconText" class="lavender-circle">♪</span>
      <span id="soundLabel" class="sound-text">Suara Aktif</span>
    </button>

    <div class="golden-ticket-badge" title="Total peserta dalam daftar">
      <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path
          d="M3 7.5C3 6.4 3.9 5.5 5 5.5H15C16.1 5.5 17 6.4 17 7.5V8.5C15.9 8.5 15 9.4 15 10.5C15 11.6 15.9 12.5 17 12.5V13.5C17 14.6 16.1 15.5 15 15.5H5C3.9 15.5 3 14.6 3 13.5V12.5C4.1 12.5 5 11.6 5 10.5C5 9.4 4.1 8.5 3 8.5V7.5Z"
          stroke="#FFFFFF"
          stroke-width="1.8"
        />
      </svg>
      <span id="nameCountBadge">0</span>
    </div>
  </div>
</header>

<style>
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.5rem;
    background-color: #FFFFFF;
    border-radius: 22px;
    box-shadow: var(--shadow-card);
    margin-bottom: 1.5rem;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .honeycomb-logo {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .brand-name {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text-dark);
    letter-spacing: -0.02em;
  }

  .topbar-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* Gaya tombol "< Back" pada layar kiri new-1.png */
  .btn-lavender-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.25rem 0.75rem 0.25rem 0.25rem;
    border-radius: 999px;
    background-color: #F6F5FC;
    transition: background-color 0.15s ease;
  }

  .btn-lavender-pill:hover {
    background-color: #ECE9FA;
  }

  .lavender-circle {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background-color: #EAE6F9;
    color: var(--purple-primary);
    font-size: 0.85rem;
    font-weight: 800;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .sound-text {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text-dark);
  }

  /* Badge Oranye-Emas "[🎟 258]" pada kanan atas new-1.png */
  .golden-ticket-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.42rem 0.9rem;
    background: linear-gradient(180deg, var(--honey-top) 0%, var(--honey-bot) 100%);
    color: #FFFFFF;
    font-size: 0.9rem;
    font-weight: 800;
    border-radius: 999px;
    box-shadow: 0 4px 12px rgba(245, 147, 30, 0.28);
    font-variant-numeric: tabular-nums;
  }
</style>
