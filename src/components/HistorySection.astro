---
---

<section class="history-section honeycomb-bg" aria-labelledby="historyHeading">
  <div class="history-header">
    <div>
      <h2 id="historyHeading" class="history-title">Riwayat Putaran</h2>
      <p id="historyCountText" class="history-sub">
        0 riwayat tersimpan di LocalStorage
      </p>
    </div>

    <div class="history-actions">
      <div class="history-filter-group" role="group" aria-label="Filter riwayat">
        <button type="button" data-filter="all" class="filter-chip active">Semua</button>
        <button type="button" data-filter="undian" class="filter-chip">Undian</button>
        <button type="button" data-filter="kelompok" class="filter-chip">Kelompok</button>
        <button type="button" data-filter="urutan" class="filter-chip">Urutan</button>
      </div>

      <button type="button" id="clearHistoryBtn" class="btn-clear-history" hidden>
        Bersihkan
      </button>
    </div>
  </div>

  <div id="historyList" class="history-grid">
    <!-- Diisi oleh JavaScript dari localStorage -->
  </div>
</section>

<style>
  .history-section {
    margin-top: 1.75rem;
    background-color: #FFFFFF;
    border-radius: 26px;
    padding: 1.75rem 1.85rem;
    box-shadow: var(--shadow-card);
  }

  .history-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .history-title {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--text-dark);
  }

  .history-sub {
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-top: 0.15rem;
  }

  .history-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .history-filter-group {
    display: inline-flex;
    background-color: #F5F4FB;
    border-radius: 12px;
    padding: 0.25rem;
    gap: 0.2rem;
  }

  .filter-chip {
    padding: 0.4rem 0.85rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text-secondary);
    border-radius: 9px;
    transition: all 0.15s ease;
  }

  .filter-chip:hover {
    color: var(--text-dark);
  }

  .filter-chip.active {
    background-color: #FFFFFF;
    color: var(--purple-primary);
    box-shadow: 0 2px 8px rgba(78, 55, 151, 0.08);
  }

  .btn-clear-history {
    padding: 0.42rem 0.85rem;
    border-radius: 10px;
    background-color: #FFF0F5;
    color: var(--pink-pointer);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .btn-clear-history:hover {
    background-color: var(--pink-pointer);
    color: #FFFFFF;
  }

  .history-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  :global(.history-empty) {
    grid-column: 1 / -1;
    padding: 2.25rem 1rem;
    text-align: center;
    background-color: #FAF9FE;
    border: 1.5px dashed var(--border-soft);
    border-radius: 18px;
    color: var(--text-muted);
    font-size: 0.86rem;
    font-weight: 500;
  }

  /* Kartu Riwayat bergaya kartu putih "Wheel of fortune / Read more" di new-1.png */
  :global(.history-card) {
    background-color: #FAF9FE;
    border: 1.5px solid var(--border-soft);
    border-radius: 20px;
    padding: 1.35rem 1.4rem 1.05rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.1rem;
    transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }

  :global(.history-card:hover) {
    transform: translateY(-2px);
    border-color: #D5CCF8;
    background-color: #FFFFFF;
    box-shadow: 0 10px 24px rgba(78, 55, 151, 0.07);
  }

  :global(.history-card-top) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  :global(.history-badge) {
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.24rem 0.7rem;
    border-radius: 999px;
    background-color: var(--bg-pill-cream);
    color: var(--honey-text);
  }

  :global(.history-badge.kelompok) {
    background-color: var(--bg-pill-purple);
    color: var(--purple-primary);
  }

  :global(.history-badge.urutan) {
    background-color: #E8F6FF;
    color: #2684C9;
  }

  :global(.history-time) {
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  :global(.history-summary) {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-dark);
    line-height: 1.45;
    margin-top: 0.65rem;
  }

  :global(.history-summary strong) {
    font-weight: 800;
    color: var(--purple-primary);
  }

  :global(.history-preview-list) {
    font-size: 0.8rem;
    color: var(--text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.5;
    margin-top: 0.35rem;
  }

  /* Footer Kartu bergaya "ⓘ Read more" di new-1.png */
  :global(.history-card-actions) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.85rem;
    border-top: 1px solid var(--border-soft);
    font-size: 0.8rem;
  }

  :global(.history-btn-view) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-secondary);
    font-weight: 700;
    transition: color 0.15s ease;
  }

  :global(.history-btn-view::before) {
    content: 'i';
    width: 17px;
    height: 17px;
    border-radius: 50%;
    background-color: #B4B6C8;
    color: #FFFFFF;
    font-size: 0.68rem;
    font-weight: 800;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  :global(.history-btn-view:hover) {
    color: var(--purple-primary);
  }

  :global(.history-btn-view:hover::before) {
    background-color: var(--purple-primary);
  }

  :global(.history-btn-delete) {
    color: var(--text-muted);
    font-weight: 600;
  }

  :global(.history-btn-delete:hover) {
    color: var(--pink-pointer);
  }
</style>
